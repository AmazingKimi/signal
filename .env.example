# ---- LLM Provider（0.3：DeepSeek 优先；OpenAI 兼容协议，可替换）
# deepseek  = 推荐（无需 LLM_BASE_URL，默认 https://api.deepseek.com，模型 deepseek-chat）
# openai    = 默认 gpt-4o-mini
# 其他      = 填 LLM_BASE_URL（如本地 Ollama: http://127.0.0.1:11434/v1）
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 不配置 LLM_API_KEY -> 自动降级规则模式：LLM 精读缺席，确定性分析照常工作。

# ---- Environment
APP_ENV=development

# ---- Local search service (automatic; ordinary users do not edit)
DEV_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=
SEARXNG_FALLBACK_URL=
SEARXNG_HOME=~/searxng

# ---- Production search providers — not required for local testing
TAVILY_API_KEY=
BRAVE_API_KEY=

# 留空即可，本地服务固定跑在 127.0.0.1:8765
