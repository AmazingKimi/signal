# ---- LLM Provider / BYOK
# SIGNAL does not ship or share any API key. Use your own local key.
# Supported: deepseek, openai, anthropic, gemini, openrouter, ollama, custom
# Aliases: claude -> anthropic, google -> gemini
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Provider defaults when LLM_BASE_URL / LLM_MODEL are left empty:
# deepseek   -> https://api.deepseek.com                  / deepseek-chat
# openai     -> https://api.openai.com/v1                / gpt-4o-mini
# anthropic  -> https://api.anthropic.com/v1             / claude-sonnet-4-20250514
# gemini     -> https://generativelanguage.googleapis.com/v1beta / gemini-2.5-flash
# openrouter -> https://openrouter.ai/api/v1             / openai/gpt-4o-mini
# ollama     -> http://127.0.0.1:11434/v1                / llama3.2 (no API key required)
# custom     -> set LLM_BASE_URL + LLM_MODEL; OpenAI-compatible protocol
#
# No LLM_API_KEY -> deterministic rule mode remains available.
# Never commit your real .env file.

# ---- Environment
APP_ENV=development

# ---- Local search service
DEV_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=
SEARXNG_FALLBACK_URL=
SEARXNG_HOME=~/searxng

# ---- Optional production search providers
TAVILY_API_KEY=
BRAVE_API_KEY=

# Local SIGNAL UI runs on 127.0.0.1:8765
